    {
      "parameters": {
        "jsCode": "const input = $input.all()[0].json;\nlet parsed;\n\ntry {\n  let content = input.output || input.text || JSON.stringify(input);\n  content = content.replace(/```json\\n?/g, '').replace(/```\\n?/g, '');\n  parsed = JSON.parse(content);\n} catch (e) {\n  parsed = {\n    short_summary: \"Latest updates\",\n    full_newsletter: \"<b>Content unavailable</b>\",\n    image_search: \"science-technology\"\n  };\n}\n\n// 🟩 Clean image search text\nconst cleanImageSearch = (parsed.image_search || \"science-technology\")\n  .toLowerCase()\n  .replace(/\\s+/g, '-')\n  .replace(/[^a-z0-9\\-]/g, '');\n\n// 🟩 Add chat_id here (pulled directly from Telegram Trigger node)\nconst chatId = $(\"Telegram Trigger\").first().json.message.chat.id;\n\nreturn [{\n  json: {\n    chat_id: chatId,  // ✅ now included in the JSON for later nodes\n    short_summary: parsed.short_summary || \"Latest updates\",\n    full_newsletter: parsed.full_newsletter || \"Content not available\",\n    image_search: cleanImageSearch\n  }\n}];\n"
      },
