        "jsCode": "const input = $input.all()[0].json;\n\n// Telegram caption limit = 1024 characters\nconst caption = input.full_newsletter || \"No content available\";\nconst maxCaption = caption.length > 1024 ? caption.slice(0, 1020) + \"...\" : caption;\n\nreturn [{\n  json: {\n    chat_id: input.chat_id, // ✅ safely available now\n    image_url: input.image_url,\n    full_newsletter: input.full_newsletter,\n    caption_short: maxCaption\n  }\n}];\n"
