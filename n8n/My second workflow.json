        "jsCode": "// The JSON you receive is like:\n// [ { \"users\": [ {...}, {...}, ... ] } ]\n\n// 1. Read the first item\nconst input = items[0].json;\n\n// 2. Use a dynamic key instead of hardcoding \"users\"\nconst dynamicKey = Object.keys(input)[0];   // <-- finds \"users\" automatically\nconst records = input[dynamicKey];\n\n// 3. Convert each record into a separate n8n item\nconst output = [];\n\nfor (const record of records) {\n  output.push({\n    json: record\n  });\n}\n\nreturn output;\n"
